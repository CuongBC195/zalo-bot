# ============================================================
# CẤU HÌNH ZALO BOT
# ============================================================
ZALO_BOT_TOKEN=your_zalo_bot_token_here
ZALO_API_BASE_URL=https://bot-api.zaloplatforms.com
POLLING_INTERVAL_SECONDS=3
ZALO_LONG_POLL_TIMEOUT_SECONDS=30
DELETE_WEBHOOK_ON_START=true

# ============================================================
# CẤU HÌNH POSTGRESQL & WEB ADMIN DASHBOARD
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zalo_dang_bot
ADMIN_PORT=3000

# ============================================================
# CẤU HÌNH GEMINI API (Dual-Key Architecture & Cross-Borrowing)
# ============================================================
# Tầng 1: Chuyên trách chuẩn hóa câu hỏi & mở rộng từ khóa chuyên môn (Lấy từ Tài khoản Google 1)
GEMINI_REWRITE_API_KEY=your_gemini_rewrite_api_key_here

# Tầng 2: Chuyên trách tổng hợp câu trả lời chuẩn mực hành chính (Lấy từ Tài khoản Google 2)
GEMINI_GENERATE_API_KEY=your_gemini_generate_api_key_here

# Fallback chung nếu 1 trong 2 biến trên để trống
GEMINI_API_KEY=your_gemini_fallback_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_REWRITE_TIMEOUT_MS=2500

# ============================================================
# CẤU HÌNH TYPESAFE JEV API (System One - Judgment & Routing)
# ============================================================
JEV_API_KEY=your_typesafe_jev_api_key_here
JEV_API_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-1.13
# Bật chế độ chạy heuristic nội bộ nếu chưa cấu hình JEV_API_KEY
ENABLE_LOCAL_JEV_FALLBACK=true

# ============================================================
# CẤU HÌNH RAG (Retrieval-Augmented Generation)
# ============================================================
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.25
ENABLE_JEV_GUARDRAIL=true


# ============================================
# KẾT NỐI DATABASE (SUPABASE / POSTGRESQL)
# ============================================
# Lưu ý khi deploy lên Vercel: Dùng Transaction Pooler (Port 6543, IPv4) để tránh lỗi ENETUNREACH
# Ví dụ Local: postgresql://postgres:postgres@localhost:5432/zalo_dang_bot
# Ví dụ Vercel/Supabase Pooler: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
